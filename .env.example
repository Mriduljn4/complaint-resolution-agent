# ==============================================================================
# Microsoft AI Stack Connection Configuration
# To connect this project to live Azure cloud services, copy this file to .env
# and populate the values from your Azure Portal / Azure AI Foundry.
# If these variables are not set, the project runs in local standalone mode.
# ==============================================================================

# 1. Azure OpenAI Service / Azure AI Foundry Model Deployment
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# 2. Azure AI Foundry Project
AZURE_AI_FOUNDRY_PROJECT_CONNECTION_STRING=<your-foundry-project-connection-string>
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group>
AZURE_AI_PROJECT_NAME=<your-foundry-project-name>

# 3. Azure AI Search (Knowledge Base Index)
AZURE_SEARCH_ENDPOINT=https://<your-search-service-name>.search.windows.net
AZURE_SEARCH_KEY=<your-search-admin-key>
AZURE_SEARCH_INDEX_NAME=banking-regulations-index

# 4. Azure Application Insights (Telemetry & Audit Spans)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<your-key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/

# 5. Azure AI Content Safety (Input Guardrails)
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-content-safety-resource>.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=<your-content-safety-key>

# 6. Azure Key Vault (Secrets Management)
AZURE_KEY_VAULT_NAME=<your-key-vault-name>

# 7. Microsoft Power Automate / Logic Apps (Teams Approval Webhook)
POWER_AUTOMATE_WEBHOOK_URL=https://prod-XX.<region>.logic.azure.com:443/workflows/<workflow-id>/triggers/manual/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=<signature>
